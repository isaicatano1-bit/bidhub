# ==============================================================================
# BIDHUB - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo a '.env' y completa las credenciales correspondientes.
# NUNCA agregues valores reales ni secretos en este archivo de plantilla.

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL alojado en Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Cadena de conexión al Connection Pooler de Supabase (puerto 6543)
# Utilizada por Prisma Client en tiempo de ejecución (modo transaccional / PgBouncer / Supavisor).
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Conexión directa a PostgreSQL en Supabase (puerto 5432)
# Utilizada exclusivamente por Prisma Migrate para ejecutar operaciones DDL y migraciones.
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN Y SEGURIDAD (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Clave secreta criptográfica (mínimo 32 caracteres) para firmar tokens de sesión con 'jose'.
# Puedes generar una clave segura con: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Duración del Access Token (ej. 15m, 1h)
JWT_EXPIRES_IN="15m"

# Duración del Refresh Token (en días)
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD DE TAREAS PROGRAMADAS (Cron Jobs)
# ------------------------------------------------------------------------------
# CRON_SECRET: Token de autorización para proteger endpoints de mantenimiento y cierre de subastas
CRON_SECRET="your-secure-cron-endpoint-secret"

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
