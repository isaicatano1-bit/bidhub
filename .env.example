# ==============================================================================
# BIDHUB - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo a '.env' y completa las credenciales correspondientes.
# NUNCA agregues valores reales ni secretos en este archivo de plantilla.

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL alojado en Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: pooler de transacciones (puerto 6543), para el runtime de la aplicación.
# Usuario y opciones exactos dependen del proyecto/panel Supabase. No reutilices la URL directa.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"

# DIRECT_URL: endpoint directo (normalmente puerto 5432), para Prisma Migrate/DDL.
# En redes sin IPv6 puede requerirse el session pooler de Supabase; copia esa cadena por separado.
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@[DIRECT_HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN Y SEGURIDAD (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Clave secreta criptográfica (mínimo 32 caracteres) para firmar tokens de sesión con 'jose'.
# Puedes generar una clave segura con: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Duración del Access Token (ej. 15m, 1h)
JWT_EXPIRES_IN="15m"

# Duración del Refresh Token (en días)
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD DE TAREAS PROGRAMADAS (Cron Jobs)
# ------------------------------------------------------------------------------
# CRON_SECRET: Token de autorización para proteger endpoints de mantenimiento y cierre de subastas
CRON_SECRET="your-secure-cron-endpoint-secret"

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ----------------------------------------------------------------------------
# 5. SEED LOCAL (opcional, sin valores predeterminados)
# ----------------------------------------------------------------------------
# Solo crea ADMIN si ambos valores existen. Usa un correo controlado y contraseña fuerte.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO_USER_PASSWORD=""
